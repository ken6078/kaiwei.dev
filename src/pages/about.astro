---
import PageLayout from '../layouts/PageLayout.astro';
import { getDictionary } from '../i18n';
const t = getDictionary('en');
---

<PageLayout lang="en" title={t.about.title} description={t.about.description} canonicalPath="/about/">
  <div class="grid gap-14 lg:grid-cols-[1.2fr_.8fr]">
    <div class="space-y-12">
      <section><h2 class="text-xl font-semibold">About me</h2><p class="mt-4 max-w-2xl leading-8 text-[var(--muted)]">I’m a software engineer with experience in algorithms, systems, and machine learning. I like turning loosely defined problems into practical, maintainable software—especially tools that help developers build, test, and understand complex systems.</p></section>
      <section>
        <h2 class="text-xl font-semibold">Experience</h2>
        <div class="mt-5 space-y-8">
          <div class="border-l border-[var(--border)] pl-5">
            <div class="flex flex-wrap justify-between gap-2">
              <h3 class="font-semibold">LFX Mentorship Co-Mentor · CNCF / KubeEdge</h3>
              <span class="font-mono text-xs text-[var(--muted)]">2026.09-2026.11</span>
            </div>
            <p class="mt-3 leading-7 text-[var(--muted)]">Co-mentoring <em>Comprehensive Example Restoration for KubeEdge Ianvs: Phase IV</em>. Supporting mentees as they restore and validate project examples, improve technical documentation, and strengthen the GitHub Actions CI pipeline across Python versions and upstream changes.</p>
            <div class="mt-3 flex flex-wrap gap-4 text-sm font-semibold text-[var(--accent)]">
              <a href="https://mentorship.lfx.linuxfoundation.org/project/0a346d47-1eff-480c-990d-fa8bf6d9e24a" target="_blank" rel="noopener noreferrer">LFX project ↗</a>
              <a href="https://github.com/cncf/mentoring/blob/main/programs/lfx-mentorship/2026/03-Sep-Nov/README.md" target="_blank" rel="noopener noreferrer">Project scope ↗</a>
            </div>
          </div>
          <div class="border-l border-[var(--border)] pl-5">
            <div class="flex flex-wrap justify-between gap-2">
              <h3 class="font-semibold">LFX Mentorship Mentee · CNCF / KubeEdge</h3>
              <span class="font-mono text-xs text-[var(--muted)]">2026.06-2026.08</span>
            </div>
            <p class="mt-3 leading-7 text-[var(--muted)]">Worked on <em>Comprehensive Example Restoration for Ianvs: Phase III</em>. Designed and implemented an automated example validation framework with static checks, smoke tests, tiered CI workflows, regression detection, and status reporting. I also improved environment setup and contributor documentation.</p>
            <div class="mt-3 flex flex-wrap gap-4 text-sm font-semibold text-[var(--accent)]">
              <a href="https://mentorship.lfx.linuxfoundation.org/project/123576ab-9c3a-4c63-a1b0-4f35c41845f2" target="_blank" rel="noopener noreferrer">LFX project ↗</a>
              <a href="https://github.com/kubeedge/ianvs/pull/771" target="_blank" rel="noopener noreferrer">Implementation PR ↗</a>
              <a href="/blog/building-example-validation-ci-cd/">Blog →</a>
            </div>
          </div>
          <div class="border-l border-[var(--border)] pl-5">
            <div class="flex flex-wrap justify-between gap-2">
              <h3 class="font-semibold">Software Engineer Intern · ADATA Technology</h3>
              <span class="font-mono text-xs text-[var(--muted)]">2024.02-2024.04</span>
            </div>
            <p class="mt-3 leading-7 text-[var(--muted)]">Developed automated SSD tests with pytest, set up PXE-based OS deployment, and built tools for OCR reporting and WinPE system diagnostics. I also helped maintain internal DNS services.</p>
          </div>
        </div>
      </section>
      <section><h2 class="text-xl font-semibold">Education</h2><div class="mt-5 space-y-6"><div><h3 class="font-semibold">National Taipei University of Technology</h3><p class="mt-1 text-[var(--muted)]">M.S. in Computer Science and Information Engineering · 2025–present</p></div><div><h3 class="font-semibold">National Ilan University</h3><p class="mt-1 text-[var(--muted)]">B.S. in Computer Science and Information Engineering · 2020–2024</p></div></div></section>
      <section><h2 class="text-xl font-semibold">Achievement</h2><p class="mt-4 leading-7 text-[var(--muted)]">Ranked 37th out of more than 2,800 participants in the 2023 Collegiate Programming Examination, placing in the top 1.3%.</p></section>
    </div>
    <aside class="space-y-8"><section><h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--muted)]">Interests</h2><ul class="mt-4 space-y-2"><li>Developer tools and infrastructure</li><li>Open-source software</li><li>Systems and automation</li><li>Applied machine learning</li></ul></section><section><h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--muted)]">Technologies</h2><p class="mt-4 leading-7 text-[var(--muted)]">C++, Python, Java, Swift, PyTorch, Docker, GitHub Actions, Linux, PostgreSQL, and Google Cloud.</p></section><section><h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--muted)]">Links</h2><div class="mt-4 flex flex-col items-start gap-2"><a class="text-[var(--accent)]" href="https://github.com/ken6078">GitHub ↗</a><a class="text-[var(--accent)]" href="https://www.linkedin.com/in/kaiweichou/">LinkedIn ↗</a><a class="text-[var(--accent)]" href="mailto:contact@kaiwei.dev">Email ↗</a></div></section></aside>
  </div>
</PageLayout>
