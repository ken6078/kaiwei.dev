---
import PageLayout from '../../layouts/PageLayout.astro';
import { getDictionary, tagLabel } from '../../i18n';
import { getPosts, tagPath } from '../../utils/posts';
const t = getDictionary('en');
const posts = await getPosts('en');
const counts = posts.flatMap((post) => post.data.tags).reduce((map, tag) => map.set(tag, (map.get(tag) ?? 0) + 1), new Map<string, number>());
---
<PageLayout lang="en" title={t.tags.title} description={t.tags.description} canonicalPath="/tags/">
  <div class="flex flex-wrap gap-3">{[...counts.entries()].sort().map(([tag, count]) => <a class="rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-sm hover:border-[var(--accent)] hover:text-[var(--accent)]" href={tagPath(tag, 'en')}>{tagLabel(tag, 'en')} <span class="text-[var(--muted)]">{count}</span></a>)}</div>
</PageLayout>
