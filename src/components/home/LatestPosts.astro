---
import PostCard from '../blog/PostCard.astro';
import type { Lang } from '../../i18n';
import { getDictionary } from '../../i18n';
import type { BlogPost } from '../../utils/posts';
interface Props { posts: BlogPost[]; lang: Lang; }
const { posts, lang } = Astro.props;
const t = getDictionary(lang);
const prefix = lang === 'zh-TW' ? '/zh-tw' : '';
---

<section class="container-site py-20">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div><h2 class="text-3xl font-semibold tracking-[-0.035em]">{t.home.latestWriting}</h2><p class="mt-3 text-[var(--muted)]">{t.home.writingLead}</p></div>
    <a class="text-sm font-semibold text-[var(--accent)]" href={`${prefix}/blog/`}>{t.home.allWriting} →</a>
  </div>
  <div class="mt-8">{posts.map((post) => <PostCard post={post} lang={lang} />)}</div>
</section>
