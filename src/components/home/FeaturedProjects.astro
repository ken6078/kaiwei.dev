---
import type { Lang } from '../../i18n';
import { getDictionary } from '../../i18n';
import type { Project } from '../../utils/posts';
interface Props { projects: Project[]; lang: Lang; }
const { projects, lang } = Astro.props;
const t = getDictionary(lang);
const prefix = lang === 'zh-TW' ? '/zh-tw' : '';
const statusLabels = lang === 'en'
  ? { active: 'Active', maintained: 'Maintained', completed: 'Completed', archived: 'Archived' }
  : { active: '持續開發', maintained: '維護中', completed: '已完成', archived: '已封存' };
---

<section class="border-y border-[var(--border)] bg-[var(--surface)]">
  <div class="container-site py-20">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div><h2 class="text-3xl font-semibold tracking-[-0.035em]">{t.home.featuredProjects}</h2><p class="mt-3 text-[var(--muted)]">{t.home.featuredLead}</p></div>
      <a class="text-sm font-semibold text-[var(--accent)]" href={`${prefix}/projects/`}>{t.home.allProjects} →</a>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {projects.map((project) => (
        <article class="rounded-lg border border-[var(--border)] bg-[var(--background)] p-6 transition-colors hover:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))]">
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-xl font-semibold tracking-[-0.025em]">{project.data.name}</h3>
            <span class="shrink-0 rounded-full border border-[var(--border)] px-2.5 py-1 text-xs text-[var(--muted)]">{statusLabels[project.data.status]}</span>
          </div>
          <p class="mt-3 leading-7 text-[var(--muted)]">{project.data.description}</p>
          <ul class="mt-6 flex flex-wrap gap-2">{project.data.technologies.map((technology) => <li class="rounded bg-[var(--surface-soft)] px-2 py-1 font-mono text-xs text-[var(--muted)]">{technology}</li>)}</ul>
          {(project.data.github || project.data.url || project.data.blog) && (
            <div class="mt-6 flex flex-wrap gap-4 text-sm font-semibold text-[var(--accent)]">
              {project.data.github && <a href={project.data.github} target="_blank" rel="noopener noreferrer">{t.projects.github} ↗</a>}
              {!project.data.github && project.data.url && <a href={project.data.url} target="_blank" rel="noopener noreferrer">{t.projects.visit} ↗</a>}
              {project.data.blog && <a href={project.data.blog}>{t.projects.readArticle} →</a>}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
