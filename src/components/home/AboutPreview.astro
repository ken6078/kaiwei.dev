---
import type { Lang } from '../../i18n';
import { getDictionary } from '../../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getDictionary(lang);
const prefix = lang === 'zh-TW' ? '/zh-tw' : '';
---

<section class="container-site pb-10 pt-6">
  <div class="grid gap-6 rounded-lg border border-[var(--border)] bg-[var(--surface)] p-7 sm:grid-cols-[.65fr_1.35fr] sm:p-10">
    <h2 class="text-2xl font-semibold tracking-[-0.03em]">{t.home.aboutTitle}</h2>
    <div><p class="leading-8 text-[var(--muted)]">{t.home.aboutBody}</p><a class="mt-5 inline-block text-sm font-semibold text-[var(--accent)]" href={`${prefix}/about/`}>{t.home.aboutCta} →</a></div>
  </div>
</section>
