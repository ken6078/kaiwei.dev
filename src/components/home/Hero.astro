---
import type { Lang } from '../../i18n';
import { getDictionary } from '../../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getDictionary(lang);
const prefix = lang === 'zh-TW' ? '/zh-tw' : '';
---

<section class="container-site relative overflow-hidden py-24 sm:py-36">
  <div class="pointer-events-none absolute right-0 top-14 -z-10 h-72 w-72 rounded-full bg-[var(--accent-soft)] blur-3xl" aria-hidden="true"></div>
  <div class="max-w-4xl">
    <p class="font-mono text-sm font-semibold uppercase tracking-[0.16em] text-[var(--accent)]">{t.home.eyebrow}</p>
    <h1 class="mt-5 text-6xl font-semibold tracking-[-0.065em] sm:text-8xl">Kai-Wei Chou</h1>
    <p class="mt-5 font-mono text-sm text-[var(--muted)] sm:text-base">{t.home.domains}</p>
    <p class="mt-9 max-w-2xl text-2xl leading-[1.4] tracking-[-0.025em] text-[var(--muted)] sm:text-3xl">{t.home.intro}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a class="focus-ring rounded-md bg-[var(--text)] px-5 py-3 text-sm font-semibold text-[var(--background)] transition-transform hover:-translate-y-0.5" href={`${prefix}/projects/`}>{t.home.projectsCta}</a>
      <a class="focus-ring rounded-md border border-[var(--border)] bg-[var(--surface)] px-5 py-3 text-sm font-semibold transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]" href={`${prefix}/blog/`}>{t.home.blogCta}</a>
      <a class="focus-ring rounded-md px-5 py-3 text-sm font-semibold text-[var(--muted)] hover:text-[var(--text)]" href="https://github.com/ken6078" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </div>
</section>
