---
import LanguageSwitch from './LanguageSwitch.astro';
import type { Lang } from '../../i18n';
import { getDictionary } from '../../i18n';

interface Props { lang: Lang; languageHref?: string | null; }
const { lang, languageHref = lang === 'en' ? '/zh-tw/' : '/' } = Astro.props;
const t = getDictionary(lang);
const prefix = lang === 'zh-TW' ? '/zh-tw' : '';
const path = Astro.url.pathname;
const links = [
  { href: `${prefix}/projects/`, label: t.nav.projects },
  { href: `${prefix}/blog/`, label: t.nav.blog },
  { href: `${prefix}/about/`, label: t.nav.about },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--background)_88%,transparent)] backdrop-blur-xl">
  <div class="container-site flex h-16 items-center justify-between gap-5">
    <a class="focus-ring text-[15px] font-semibold tracking-tight" href={`${prefix}/`} aria-label={t.a11y.home}>Kai-Wei</a>
    <nav class="flex items-center gap-4 sm:gap-6" aria-label={t.a11y.primaryNavigation}>
      {links.map((link) => (
        <a class:list={["focus-ring text-sm font-medium transition-colors hover:text-[var(--text)]", path.startsWith(link.href) ? 'text-[var(--text)]' : 'text-[var(--muted)]']} href={link.href}>{link.label}</a>
      ))}
      <span class="hidden h-4 w-px bg-[var(--border)] sm:block"></span>
      <LanguageSwitch lang={lang} href={languageHref} />
      <a class="focus-ring hidden text-sm font-medium text-[var(--muted)] transition-colors hover:text-[var(--text)] sm:block" href="https://github.com/ken6078" target="_blank" rel="me noopener noreferrer">GitHub</a>
    </nav>
  </div>
</header>
