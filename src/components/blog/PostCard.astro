---
import type { BlogPost } from '../../utils/posts';
import { postPath } from '../../utils/posts';
import type { Lang } from '../../i18n';
import PostMeta from './PostMeta.astro';
interface Props { post: BlogPost; lang: Lang; }
const { post, lang } = Astro.props;
---

<article class="group grid gap-6 border-t border-[var(--border)] py-8 sm:grid-cols-[1fr_180px]">
  <div class="min-w-0">
    <PostMeta published={post.data.published} updated={post.data.updated} tags={post.data.tags} lang={lang} />
    <h2 class="mt-3 text-2xl font-semibold tracking-[-0.025em]">
      <a class="focus-ring before:absolute before:inset-0 group-hover:text-[var(--accent)]" href={postPath(post)}>{post.data.title}</a>
    </h2>
    <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{post.data.description}</p>
  </div>
  {post.data.cover ? (
    <img class="order-first aspect-[16/10] w-full rounded-md border border-[var(--border)] object-cover sm:order-last" src={post.data.cover} alt="" loading="lazy" />
  ) : (
    <div class="order-first hidden aspect-[16/10] rounded-md border border-[var(--border)] bg-[linear-gradient(135deg,var(--accent-soft),var(--surface-soft))] sm:order-last sm:block" aria-hidden="true"></div>
  )}
</article>

<style>article { position: relative; }</style>
