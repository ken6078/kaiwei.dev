---
import type { Lang } from '../../i18n';
import { getDictionary, tagLabel } from '../../i18n';
import { formatDate } from '../../utils/dates';
import { tagPath } from '../../utils/posts';
interface Props { published: Date; updated?: Date; tags: string[]; lang: Lang; }
const { published, updated, tags, lang } = Astro.props;
const t = getDictionary(lang);
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-[var(--muted)]">
  <time datetime={published.toISOString()}>{formatDate(published, lang)}</time>
  {updated && updated.valueOf() !== published.valueOf() && <span>·</span>}
  {updated && updated.valueOf() !== published.valueOf() && <time datetime={updated.toISOString()}>{t.blog.updated} {formatDate(updated, lang)}</time>}
  {tags.length > 0 && <span>·</span>}
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => <a class="hover:text-[var(--accent)]" href={tagPath(tag, lang)}>#{tagLabel(tag, lang)}</a>)}
  </div>
</div>
